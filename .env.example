# ═════════════════════════════════════════════════════════════════════════════
# MindSetu — Production & Local Environment Variables (.env.example)
# ═════════════════════════════════════════════════════════════════════════════
# IMPORTANT: Never commit actual credentials, passwords, or API keys to Git.
# Configure these variables in your deployment environment or local .env file.

# ── 1. Database Configuration (SERVER-ONLY) ───────────────────────────────────
# Managed PostgreSQL (Neon / Supabase - Recommended)
# DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL parameters (Alternative for local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mindsetu_db
DB_USER=postgres
DB_PASSWORD=change_me_locally

# ── 2. Google Gemini AI Companion (SERVER-ONLY) ──────────────────────────────
GEMINI_API_KEY=your_real_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TOTAL_TIMEOUT_SECONDS=15

# ── 3. CORS Allowed Origins (Optional) ─────────────────────────────────────────
# CORS_ORIGINS=https://your-mindsetu-domain.com,http://localhost:5173
