# ── Database ──────────────────────────────────────────────────
# Option 1: Render-style connection string (takes priority)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual connection parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mindsetu_db
DB_USER=postgres
DB_PASSWORD=change_me_locally

# ── Google Gemini API ─────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TOTAL_TIMEOUT_SECONDS=15

# ── CORS (comma-separated origins) ───────────────────────────
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Never commit a real .env file, passwords, API keys, or personnel data.
