# ── Database ──────────────────────────────────────────────────
# Option 1: Managed DB connection string (recommended for production)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual connection parameters (local development)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mindsetu_db
DB_USER=postgres
DB_PASSWORD=change_me_locally

# ── Google Gemini API ─────────────────────────────────────────
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TOTAL_TIMEOUT_SECONDS=15

# ── CORS (comma-separated list — REQUIRED for production) ─────
# Add your frontend production URL here; without it the browser will block cross-origin calls.
# CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# Never commit a real .env file, passwords, API keys, or personnel data.
